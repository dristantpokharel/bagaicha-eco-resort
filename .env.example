# Names only. Real values live in .env.local (never committed).

# Site
NEXT_PUBLIC_SITE_URL=
# "staging" on the Netlify test site (placeholders visible, banner, noindex, no sitemap). Empty elsewhere.
SITE_ENV=
# Staging only: when set, every route asks for HTTP basic auth (any username, this password).
STAGING_PASSWORD=

# Database (Neon): pooled URL for the app, direct URL for migrations
DATABASE_URL=
DIRECT_URL=

# Auth.js
AUTH_SECRET=
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Where "new booking request" and "new enquiry" alerts go.
BOOKING_ALERT_TO=
# Dev and staging: when set, EVERY email goes to these addresses (one, or comma-separated) and the
# subject names the intended recipient. Required on staging (no value = no email is sent).
# Leave empty in production so emails go to real recipients.
EMAIL_DEV_TO=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
