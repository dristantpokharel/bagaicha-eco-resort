# Copy to .env.local and fill in. Never commit real secrets.

# Public origin used for metadata and canonical URLs (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://bagaichaecoresort.com

# Cloudinary (server-side only; the API secret is never sent to the browser).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
