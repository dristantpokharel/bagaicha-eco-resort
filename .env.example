# Names only. Real values live in .env.local (never committed).

# Site
NEXT_PUBLIC_SITE_URL=

# Database (Neon): pooled URL for the app, direct URL for migrations
DATABASE_URL=
DIRECT_URL=

# Auth.js
AUTH_SECRET=
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Where "new booking request" and "new enquiry" alerts go.
BOOKING_ALERT_TO=
# Dev only: when set, EVERY email goes to this address and the subject names the
# intended recipient. Leave empty in production so emails go to real recipients.
EMAIL_DEV_TO=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
